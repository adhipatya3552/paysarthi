# PaySarthi — copy to .env and fill locally. NEVER commit .env.
# --- PayPal Sandbox (backend only; never expose to the frontend) ---
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_CLIENT_ID=your_sandbox_app_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_app_client_secret
PAYPAL_MERCHANT_EMAIL=sb-merchant@business.example.com
PAYPAL_BUYER_EMAIL=sb-buyer@personal.example.com
PUBLIC_BASE_URL=
WEBHOOK_ID=
PORT=8000
# --- AI provider (OpenAI-compatible; free-tier default model, override freely) ---
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# --- MySQL/MariaDB (local dev may use root with empty password) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=paysarthi
# --- App security (set a password before any public deployment) ---
DEMO_PASSWORD=
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
